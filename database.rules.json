{
  "rules": {
    "markers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$markerId": {
        "note": {
          ".write": "auth != null && newData.isString() && newData.val().length < 500"
        }
      }
    },
    "custom_routes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deleted_markers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "urgent_news": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_reports": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$reportId": {
        ".write": "auth != null && (!data.exists() && newData.exists() && newData.hasChildren(['lat', 'lng', 'type', 'timestamp']))"
      }
    },
    "fcm_tokens": {
      ".read": "auth != null",
      "$tokenId": {
        ".write": "auth != null && newData.exists() && newData.hasChildren(['token', 'timestamp'])"
      }
    },
    "admin_settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "authorized_users": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
