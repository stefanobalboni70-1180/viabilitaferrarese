{
  "rules": {
    "markers": {
      ".read": true,
      ".write": "auth != null",
      "$markerId": {
        "note": {
          ".write": "newData.isString() && newData.val().length < 500"
        }
      }
    },
    "deleted_markers": {
      ".read": true,
      ".write": "auth != null"
    },
    "user_reports": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$reportId": {
        ".write": "!data.exists() && newData.exists() && newData.hasChildren(['lat', 'lng', 'type', 'timestamp'])"
      }
    }
  }
}
